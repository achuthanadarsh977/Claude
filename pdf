  def recommend(user):
      watched   = set(user_ratings[user].keys())
      all_movies = set(m for u in user_ratings for m in user_ratings[u])
      unwatched  = all_movies - watched

      scores = {}
      for movie in unwatched:
          scores[movie] = sum(
              user_ratings[u].get(movie, 0)
              for u in user_ratings if u != user
          )
      return sorted(scores, key=scores.get, reverse=True)

  print(recommend("Adarsh"))  # ['Tenet']

