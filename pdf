  6. Stack & Queue Implementation (Class + List)

  class Stack:
      def __init__(self):   self.data = []
      def push(self, x):    self.data.append(x)
      def pop(self):        return self.data.pop() if self.data else "Empty"
      def peek(self):       return self.data[-1] if self.data else "Empty"
      def is_empty(self):   return len(self.data) == 0

  class Queue:
      def __init__(self):   self.data = []
      def enqueue(self, x): self.data.append(x)
      def dequeue(self):    return self.data.pop(0) if self.data else "Empty"
      def front(self):      return self.data[0] if self.data else "Empty"

  # Stack (LIFO)
  s = Stack()
  s.push(1); s.push(2); s.push(3)
  print(s.pop())    # 3

  # Queue (FIFO)
  q = Queue()
  q.enqueue("A"); q.enqueue("B"); q.enqueue("C")
  print(q.dequeue())  # A

