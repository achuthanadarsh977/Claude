  10. Word Frequency Analyzer (Dict + Sorting)

  def analyze(text):
      words = text.lower().split()
      freq  = {}
      for w in words:
          w = w.strip(".,!?")
          freq[w] = freq.get(w, 0) + 1
      return freq

  def top_words(freq, n=5):
      return sorted(freq.items(), key=lambda x: x[1], reverse=True)[:n]

  def unique_words(freq):
      return [w for w, c in freq.items() if c == 1]

  text = """Python is great. Python is easy.
            Learning Python is fun. Data structures are important in Python."""

  freq = analyze(text)
  print("Top 3 words:", top_words(freq, 3))
  print("Unique words:", unique_words(freq))
