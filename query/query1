      import sqlite3
      conn = sqlite3.connect(r'C:\Users\SriniAchuthan\.local\bin\ecommerce.db')
      cursor = conn.cursor()

      cursor.execute('''
          SELECT
              c2.name as parent_category,
              c1.name as category,
              p.sku,
              p.name as product,
              p.price,
              p.is_active
          FROM products p
          JOIN categories c1 ON p.category_id = c1.id
          LEFT JOIN categories c2 ON c1.parent_category_id = c2.id
          ORDER BY c2.name, c1.name, p.price DESC
      ''')

      current_parent = None
      current_cat = None

      for row in cursor.fetchall():
          parent, cat, sku, name, price, active = row

          if parent != current_parent:
              current_parent = parent
              print()
              print('=' * 65)
              print('  {}'.format(parent.upper()))
              print('=' * 65)

          if cat != current_cat:
              current_cat = cat
              print()
              print('  {} '.format(cat))
              print('  ' + '-' * 50)

          status = '' if active else ' [INACTIVE]'
          print('    {:12} {:30} USD {:>8.2f}{}'.format(sku, name, price, status))

      # Summary
