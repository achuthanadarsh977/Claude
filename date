> explain date and time extraction libraries in typescript

● Date & Time Libraries in TypeScript

  ---
  1. date-fns — Functional, modular

  import { format, parseISO, differenceInDays, addDays, isAfter } from 'date-fns';

  const date = new Date();

  format(date, 'yyyy-MM-dd');              // "2026-02-26"
  format(date, 'dd/MM/yyyy HH:mm:ss');    // "26/02/2026 14:30:00"
  format(date, 'MMMM do, yyyy');          // "February 26th, 2026"

  // Parsing
  const parsed = parseISO('2026-02-26');

  // Arithmetic
  addDays(date, 7);                        // 7 days from now
  differenceInDays(new Date('2026-03-01'), date); // days between dates

  // Comparison
  isAfter(new Date('2026-03-01'), date);   // true

  Pros: Tree-shakable, immutable, great TypeScript support
  Install: npm i date-fns

  ---
  2. dayjs — Lightweight Moment.js alternative

  import dayjs from 'dayjs';
  import relativeTime from 'dayjs/plugin/relativeTime';
  import utc from 'dayjs/plugin/utc';

  dayjs.extend(relativeTime);
  dayjs.extend(utc);

  dayjs().format('YYYY-MM-DD');            // "2026-02-26"
  dayjs('2026-02-26').add(1, 'month');     // March 26
  dayjs('2026-02-26').subtract(7, 'day');
  dayjs('2025-01-01').fromNow();           // "a year ago"

  // UTC
  dayjs.utc('2026-02-26T10:00:00Z').format();

  // Parsing
  dayjs('26/02/2026', 'DD/MM/YYYY');

  Pros: ~2KB, Moment.js API compatible, plugin system
  Install: npm i dayjs

  ---
  3. luxon — Modern, timezone-first

  import { DateTime, Duration, Interval } from 'luxon';

  const dt = DateTime.now();

  dt.toFormat('yyyy-MM-dd');               // "2026-02-26"
  dt.toLocaleString(DateTime.DATE_FULL);  // "February 26, 2026"

  // Timezone handling
  DateTime.now().setZone('America/New_York').toISO();
  DateTime.fromISO('2026-02-26T10:00:00', { zone: 'utc' });

  // Arithmetic
  dt.plus({ days: 7, hours: 2 });
  dt.minus({ months: 1 });

  // Duration
  const dur = Duration.fromObject({ hours: 3, minutes: 30 });
  dur.toFormat('hh:mm');                   // "03:30"

  // Interval
  const interval = Interval.fromDateTimes(dt, dt.plus({ days: 5 }));
  interval.length('days');                 // 5
  interval.contains(DateTime.now());       // true

  Pros: Best timezone support, immutable, built-in i18n
  Install: npm i luxon @types/luxon

  ---
  4. moment — Legacy (avoid for new projects)

  import moment from 'moment';

  moment().format('YYYY-MM-DD');
  moment('2026-02-26').add(7, 'days').format('LL');
  moment('2025-01-01').fromNow();          // "a year ago"

  Cons: Mutable, large bundle (~67KB), officially in maintenance mode

  ---
  5. Built-in Temporal API (Stage 3 — future standard)

  // Available via polyfill: npm i @js-temporal/polyfill
  import { Temporal } from '@js-temporal/polyfill';

  const today = Temporal.Now.plainDateISO();
  today.toString();                        // "2026-02-26"
  today.add({ days: 7 }).toString();       // "2026-03-05"

  // Time zones
  Temporal.Now.zonedDateTimeISO('Asia/Kolkata').toString();

