  import re
  import numpy as np
  import faiss
  from sentence_transformers import SentenceTransformer
  import anthropic

  # ── 1. LOAD & CHUNK ──────────────────────────────────────────────
  with open(r'C:\Users\SriniAchuthan\Downloads\report.md', 'r', encoding='utf-8') as f:
      text = f.read()

  chunks = re.split(r'\n(?=## )', text)
  chunks = [c.strip() for c in chunks if c.strip()]
  print(f'Chunks loaded: {len(chunks)}')

  # ── 2. EMBED ─────────────────────────────────────────────────────
  print('Embedding chunks...')
  model = SentenceTransformer('all-MiniLM-L6-v2')
  embeddings = np.array(model.encode(chunks)).astype('float32')
  print(f'Embedding shape: {embeddings.shape}')

  # ── 3. VECTOR STORE (FAISS) ──────────────────────────────────────
  index = faiss.IndexFlatL2(embeddings.shape[1])
  index.add(embeddings)
  print(f'FAISS index: {index.ntotal} vectors ready')

  # ── 4. RETRIEVER ─────────────────────────────────────────────────
  def retrieve(query, top_k=3):
      q_vec = model.encode([query]).astype('float32')
      _, indices = index.search(q_vec, top_k)
      return [chunks[i] for i in indices[0]]

  # ── 5. RAG PIPELINE ──────────────────────────────────────────────
  client = anthropic.Anthropic(api_key='your-api-key-here')  # ← add key here

  def ask(question):
      print(f'\nQ: {question}')
      print('-' * 60)
      context = '\n\n---\n\n'.join(retrieve(question, top_k=3))
      response = client.messages.create(
          model='claude-sonnet-4-6',
          max_tokens=512,
          messages=[{
              'role': 'user',
              'content': f'''Answer the question using ONLY the context below.
  If the answer is not in the context, say "Not found in document".

  Context:
  {context}

  Question: {question}
  Answer:'''
          }]
      )
      print(response.content[0].text)

