  from mcp.server.fastmcp import FastMCP

  mcp = FastMCP("HospitalMCP", log_level="ERROR")

  # Static resource
  @mcp.resource("hospital://guidelines/treatment")
  def treatment_guidelines():
      return "Fever > 103F: Doctor consult | BP > 140/90: Medication"

  # Dynamic resource
  @mcp.resource("hospital://patient/{patient_id}/report")
  def patient_report(patient_id: str):
      data = {
          "P001": "John | Diabetic | Last visit: Jan 2026",
          "P002": "Jane | Asthma   | Last visit: Feb 2026",
      }
      return data.get(patient_id, f"No record for {patient_id}")

